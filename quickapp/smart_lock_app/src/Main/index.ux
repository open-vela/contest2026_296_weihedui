<template>
  <div class="container">
    <!-- 状态栏 -->
    <div class="status-bar">
      <text class="status-text">BLE状态: {{connected ? '已连接' : '未连接'}}</text>
    </div>

    <!-- 门锁状态 -->
    <div class="door-status">
      <div class="status-icon {{doorState === 'closed' ? 'locked' : 'unlocked'}}">
        <text class="icon-text">{{doorState === 'closed' ? '🔒' : '🔓'}}</text>
      </div>
      <text class="status-label">门状态: {{doorState === 'closed' ? '已关闭' : '已开启'}}</text>
      <text class="status-label">锁状态: {{lockState === 'locked' ? '已锁定' : '未锁定'}}</text>
    </div>

    <!-- 控制按钮 -->
    <div class="controls">
      <button class="btn btn-open" onclick="openDoor" disabled="{{!connected}}">
        开门
      </button>
      <button class="btn btn-close" onclick="closeDoor" disabled="{{!connected}}">
        关门
      </button>
      <button class="btn btn-lock" onclick="lockDoor" disabled="{{!connected}}">
        锁门
      </button>
      <button class="btn btn-unlock" onclick="unlockDoor" disabled="{{!connected}}">
        解锁
      </button>
    </div>

    <!-- 连接按钮 -->
    <div class="connection">
      <button class="btn btn-connect" onclick="connectDevice" disabled="{{connected}}">
        {{connected ? '已连接' : '连接设备'}}
      </button>
      <button class="btn btn-disconnect" onclick="disconnectDevice" disabled="{{!connected}}">
        断开连接
      </button>
    </div>

    <!-- 扫描按钮 -->
    <div class="scan">
      <button class="btn btn-scan" onclick="scanDevices">
        扫描设备
      </button>
    </div>

    <!-- 设备列表 -->
    <div class="device-list" if="{{devices.length > 0}}">
      <text class="list-title">发现的设备:</text>
      <div class="device-item" for="{{devices}}" onclick="selectDevice($item)">
        <text>{{$item.name || '未知设备'}}</text>
        <text class="device-id">{{$item.id}}</text>
      </div>
    </div>
  </div>
</template>

<style>
.container {
  flex-direction: column;
  padding: 20px;
  background-color: #f5f5f5;
}

.status-bar {
  background-color: #4CAF50;
  padding: 10px;
  border-radius: 5px;
  margin-bottom: 20px;
}

.status-text {
  color: white;
  text-align: center;
}

.door-status {
  align-items: center;
  margin-bottom: 30px;
}

.status-icon {
  width: 100px;
  height: 100px;
  border-radius: 50%;
  justify-content: center;
  align-items: center;
  margin-bottom: 10px;
}

.status-icon.locked {
  background-color: #4CAF50;
}

.status-icon.unlocked {
  background-color: #f44336;
}

.icon-text {
  font-size: 40px;
}

.status-label {
  font-size: 18px;
  margin-bottom: 5px;
}

.controls {
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: space-around;
  margin-bottom: 20px;
}

.btn {
  width: 140px;
  height: 50px;
  border-radius: 25px;
  margin: 5px;
  justify-content: center;
  align-items: center;
}

.btn-open {
  background-color: #2196F3;
}

.btn-close {
  background-color: #FF9800;
}

.btn-lock {
  background-color: #4CAF50;
}

.btn-unlock {
  background-color: #f44336;
}

.btn-connect {
  background-color: #9C27B0;
}

.btn-disconnect {
  background-color: #795548;
}

.btn-scan {
  background-color: #607D8B;
}

.connection {
  flex-direction: row;
  justify-content: space-around;
  margin-bottom: 20px;
}

.scan {
  margin-bottom: 20px;
}

.device-list {
  background-color: white;
  padding: 10px;
  border-radius: 5px;
}

.list-title {
  font-size: 16px;
  font-weight: bold;
  margin-bottom: 10px;
}

.device-item {
  flex-direction: row;
  justify-content: space-between;
  padding: 10px;
  border-bottom-width: 1px;
  border-bottom-color: #eee;
}

.device-id {
  color: #666;
  font-size: 12px;
}
</style>

<script>
import ble from '@system.bluetooth';

export default {
  data: {
    connected: false,
    doorState: 'unknown',
    lockState: 'unknown',
    devices: [],
    deviceId: ''
  },

  onInit() {
    this.bleManager = new BLEManager();
    this.checkBLEStatus();
  },

  // 检查BLE状态
  async checkBLEStatus() {
    try {
      const status = await ble.getStatus();
      console.log('BLE状态:', status);
    } catch (e) {
      console.error('获取BLE状态失败:', e);
    }
  },

  // 扫描设备
  async scanDevices() {
    try {
      this.devices = [];
      const devices = await ble.scan({
        services: ['0x1820']
      });
      this.devices = devices;
      console.log('发现设备:', devices);
    } catch (e) {
      console.error('扫描失败:', e);
    }
  },

  // 选择设备
  selectDevice(device) {
    this.deviceId = device.id;
    console.log('选择设备:', device);
  },

  // 连接设备
  async connectDevice() {
    if (!this.deviceId) {
      console.error('请先选择设备');
      return;
    }

    try {
      await this.bleManager.connect(this.deviceId);
      this.connected = true;
      this.updateState();
      console.log('连接成功');
    } catch (e) {
      console.error('连接失败:', e);
    }
  },

  // 断开连接
  async disconnectDevice() {
    try {
      await this.bleManager.disconnect();
      this.connected = false;
      this.doorState = 'unknown';
      this.lockState = 'unknown';
      console.log('已断开连接');
    } catch (e) {
      console.error('断开失败:', e);
    }
  },

  // 开门
  async openDoor() {
    try {
      await this.bleManager.sendCommand('open');
      this.updateState();
    } catch (e) {
      console.error('开门失败:', e);
    }
  },

  // 关门
  async closeDoor() {
    try {
      await this.bleManager.sendCommand('close');
      this.updateState();
    } catch (e) {
      console.error('关门失败:', e);
    }
  },

  // 锁门
  async lockDoor() {
    try {
      await this.bleManager.sendCommand('lock');
      this.updateState();
    } catch (e) {
      console.error('锁门失败:', e);
    }
  },

  // 解锁
  async unlockDoor() {
    try {
      await this.bleManager.sendCommand('unlock');
      this.updateState();
    } catch (e) {
      console.error('解锁失败:', e);
    }
  },

  // 更新状态
  async updateState() {
    try {
      const state = await this.bleManager.readState();
      this.doorState = state.door_state;
      this.lockState = state.lock_state;
    } catch (e) {
      console.error('读取状态失败:', e);
    }
  }
};

// BLE管理器
class BLEManager {
  constructor() {
    this.device = null;
    this.service = null;
    this.characteristic = null;
  }

  // 连接设备
  async connect(deviceId) {
    this.device = await ble.connect(deviceId);
    this.service = await this.device.getService('0x1820');
    this.characteristic = await this.service.getCharacteristic('0x2B20');
  }

  // 断开连接
  async disconnect() {
    if (this.device) {
      await this.device.disconnect();
      this.device = null;
      this.service = null;
      this.characteristic = null;
    }
  }

  // 读取状态
  async readState() {
    if (!this.characteristic) {
      throw new Error('未连接');
    }
    const value = await this.characteristic.read();
    return {
      door_state: value[0] === 0 ? 'closed' : 'open',
      lock_state: value[1] === 0 ? 'locked' : 'unlocked'
    };
  }

  // 发送命令
  async sendCommand(cmd) {
    if (!this.service) {
      throw new Error('未连接');
    }
    const characteristic = await this.service.getCharacteristic('0x2B21');
    const cmdMap = {
      'open': 0x01,
      'close': 0x02,
      'lock': 0x03,
      'unlock': 0x04
    };
    await characteristic.write([cmdMap[cmd]]);
  }
}
</script>
