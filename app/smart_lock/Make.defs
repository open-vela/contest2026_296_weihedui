ifeq ($(CONFIG_SMART_LOCK),y)
  CSRCS += src/radar_driver.c
  CSRCS += src/door_sensor.c
endif

DEPPATH += --dep-path src
VPATH += :src
CFLAGS += ${INCDIR_PREFIX}$(APPDIR)/smart_lock/include
