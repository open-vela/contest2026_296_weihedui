      },
      "door_locked.pcm": {
        "text": "门已锁定",
        "duration": 1.0,
        "priority": 1
      },
      "door_unlocked.pcm": {
        "text": "门已解锁",
        "duration": 1.0,
        "priority": 1
      }
    },
